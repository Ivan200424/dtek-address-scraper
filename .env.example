# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL (окремі параметри)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=power_outage_bot
DB_USER=postgres
DB_PASSWORD=your_password_here

# PostgreSQL (альтернативно — один URL, пріоритет)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Моніторинг
CHECK_INTERVAL=300

# Логування
LOG_LEVEL=INFO

# Часова зона
TZ=Europe/Kiev

# Ліміти
MAX_ADDRESSES_PER_USER=10
BROWSER_TIMEOUT=30
